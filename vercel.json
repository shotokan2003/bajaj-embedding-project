{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },  "env": {
    "VERCEL": "1",
    "USE_REDIS": "1",
    "CEREBRAS_MODEL": "llama-4-scout-17b-16e-instruct"
  }
}